generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}
datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  WAITING
  DONE
  ARCHIVED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED
}
enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}
enum EmailCategory {
  IMPORTANT
  RECRUITING
  MEETING
  PROJECT
  FOLLOW_UP
  FINANCE
  NEWSLETTER
  PERSONAL
  OTHER
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts Account[]
  sessions Session[]
  connection GoogleConnection?
  emails Email[]
  tasks Task[]
  approvals ApprovalRequest[]
  runs AgentRun[]
  settings UserSettings?
  briefs DailyBrief[]
}
model Session {
  id String @id @default(cuid())
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id @default(cuid())
  accountId String
  providerId String
  issuer String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([issuer, accountId])
  @@index([providerId])
  @@index([userId])
}
model Verification {
  id String @id @default(cuid())
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model GoogleConnection {
  id String @id @default(cuid())
  userId String @unique
  googleEmail String
  scopes String[]
  encryptedAccessToken String?
  encryptedRefreshToken String?
  expiresAt DateTime?
  status String @default("CONNECTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Email {
  id String @id @default(cuid())
  userId String
  gmailMessageId String
  gmailThreadId String?
  sender String
  subject String
  receivedAt DateTime
  preview String
  bodyText String?
  unread Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Boolean @default(false)
  analysisRecord EmailAnalysis?
  drafts EmailDraft[]
  tasks Task[]
  runs AgentRun[]
  @@unique([userId, gmailMessageId])
  @@index([userId, receivedAt(sort: Desc)])
}
model EmailAnalysis {
  id String @id @default(cuid())
  emailId String @unique
  summary String
  category EmailCategory
  priority Priority
  requiresAction Boolean
  schedulingIntent Boolean
  actionItems Json
  createdAt DateTime @default(now())
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
}
model EmailDraft {
  id String @id @default(cuid())
  emailId String
  body String
  recipients String[]
  subject String
  status String @default("SUGGESTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
  approvals ApprovalRequest[]
}
model Task {
  id String @id @default(cuid())
  userId String
  emailId String?
  title String
  description String?
  priority Priority
  status TaskStatus @default(TODO)
  dueAt DateTime?
  labels String[]
  source String @default("USER")
  createdByAi Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  @@index([userId, status])
}
model CalendarEvent {
  id String @id @default(cuid())
  userId String
  googleEventId String
  startAt DateTime
  endAt DateTime
  title String
  attendees String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, googleEventId])
  @@index([userId, startAt])
}
model ApprovalRequest {
  id String @id @default(cuid())
  userId String
  draftId String?
  runId String?
  type String
  reason String
  riskLevel String @default("MEDIUM")
  payload Json
  status ApprovalStatus @default(PENDING)
  executionKey String @unique @default(cuid())
  requestedAt DateTime @default(now())
  decidedAt DateTime?
  executedAt DateTime?
  error String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft EmailDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  run AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@index([userId, status])
}
model AgentRun {
  id String @id @default(cuid())
  userId String
  emailId String?
  trigger String
  status AgentRunStatus @default(QUEUED)
  startedAt DateTime?
  finishedAt DateTime?
  error String?
  inputSummary String?
  resultSummary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  steps AgentStep[]
  toolCalls AgentToolCall[]
  approvals ApprovalRequest[]
  @@index([userId, createdAt(sort: Desc)])
}
model AgentStep {
  id String @id @default(cuid())
  agentRunId String
  type String
  title String
  description String?
  status String
  metadata Json?
  startedAt DateTime @default(now())
  completedAt DateTime?
  run AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  @@index([agentRunId, startedAt])
}
model AgentToolCall {
  id String @id @default(cuid())
  agentRunId String
  toolName String
  validatedInput Json
  resultSummary String?
  status String
  durationMs Int?
  error String?
  timestamp DateTime @default(now())
  run AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  @@index([agentRunId, timestamp])
}
model DailyBrief {
  id String @id @default(cuid())
  userId String
  date DateTime
  content String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
}
model UserSettings {
  id String @id @default(cuid())
  userId String @unique
  timezone String @default("UTC")
  workingHourStart Int @default(9)
  workingHourEnd Int @default(17)
  meetingDuration Int @default(30)
  meetingBuffer Int @default(15)
  theme String @default("system")
  accent String @default("violet")
  motion String @default("full")
  density String @default("comfortable")
  taskView String @default("kanban")
  autoCategorize Boolean @default(true)
  autoCreateTasks Boolean @default(true)
  autoDraftReplies Boolean @default(true)
  requireSendApproval Boolean @default(true)
  requireScheduleApproval Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model EventRecord {
  id String @id @default(cuid())
  userId String
  type String
  runId String?
  message String
  data Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
